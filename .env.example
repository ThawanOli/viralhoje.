# Banco de dados. Para produção, troque por uma URL postgresql:// (ex: Neon, Supabase, Railway).
DATABASE_URL="file:./dev.db"

# Gere valores aleatórios longos para os 3 segredos abaixo, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio-de-64-caracteres"
CPF_ENCRYPTION_KEY="troque-por-64-caracteres-hexadecimais-ex-saida-do-comando-acima"
CPF_HASH_SECRET="troque-por-outro-valor-aleatorio-longo"

# Autenticação na YouTube Data API v3: preencha UMA das duas opções abaixo (README explica como).
# Opção A - chave de API simples (mais fácil):
YOUTUBE_API_KEY="sua-chave-da-youtube-data-api-v3"
# Opção B - conta de serviço do Google Cloud (deixe YOUTUBE_API_KEY vazio se usar esta):
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Token que o job de cron externo deve enviar no header x-cron-secret
# para autorizar a atualização diária das tendências.
CRON_SECRET="troque-por-um-token-secreto-para-o-cron"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
